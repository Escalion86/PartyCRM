NODE_ENV=production

DOMAIN=https://partycrm.ru
MONGODB_URI=mongodb://user:password@127.0.0.1:27017/?authSource=admin
MONGODB_DBNAME=partycrm
# For one shared ArtistCRM + PartyCRM runtime, keep MONGODB_* for ArtistCRM
# and configure PartyCRM separately:
# PARTYCRM_SHARED_RUNTIME=true
# PARTYCRM_MONGODB_URI=mongodb://user:password@127.0.0.1:27017/?authSource=admin
# PARTYCRM_MONGODB_DBNAME=partycrm
AUTH_SECRET=replace-with-production-secret
PARTYCRM_SECRET=replace-with-bootstrap-secret

NEXT_PUBLIC_LEGAL_NAME=PartyCRM
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@partycrm.ru

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
TOCHKA_API_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_SEND_RECEIPT=false
TOCHKA_VAT_TYPE=none
TOCHKA_RECEIPT_ITEM_NAME=Оплата PartyCRM
TOCHKA_RECEIPT_EMAIL=support@partycrm.ru
BILLING_CRON_SECRET=
