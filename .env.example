NODE_ENV=development

# Core PartyCRM routing
DOMAIN=http://localhost:3000

# Core PartyCRM database
MONGODB_URI=mongodb://127.0.0.1:27017/partycrm
MONGODB_DBNAME=partycrm

# Shared ArtistCRM + PartyCRM runtime only:
# PARTYCRM_SHARED_RUNTIME=true
# PARTYCRM_MONGODB_URI=mongodb://127.0.0.1:27017/partycrm
# PARTYCRM_MONGODB_DBNAME=partycrm

# PartyCRM auth secrets
NEXTAUTH_SECRET=
LOGIN=
PASSWORD=

# PartyCRM phone verification (TELEFONIP)
TELEFONIP=
TELEFONIP_API_BASE_URL=https://api.telefon-ip.ru
PHONE_SMS_SEND_WEBHOOK=
PHONE_VERIFY_TTL_MIN=15

# PartyCRM billing
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
TOCHKA_API_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_SEND_RECEIPT=false
TOCHKA_VAT_TYPE=none
TOCHKA_RECEIPT_ITEM_NAME=Оплата PartyCRM
TOCHKA_RECEIPT_EMAIL=support@partycrm.ru
BILLING_CRON_SECRET=

# Optional diagnostics
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
