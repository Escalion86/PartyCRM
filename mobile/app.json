{
  "expo": {
    "name": "ArtistCRM",
    "slug": "artistcrm-mobile",
    "scheme": "artistcrm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1d1f"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.escalion.artistcrm",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ArtistCRM uses the camera for profile photos and document scanning.",
        "NSPhotoLibraryUsageDescription": "ArtistCRM accesses your photo library for profile photos and document attachments.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f7efe1"
      },
      "package": "ru.escalion.artistcrm",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7676a13a-3d4a-4da0-ad23-5b4df7b3bb38"
      }
    },
    "owner": "escalion"
  }
}
